# =============================================================================
# COZY LOOPS E-COMMERCE FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This is a template file for environment variables
# Copy this file to .env and replace placeholder values with your actual credentials
# Never commit real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API endpoints for development and production
NEXT_PUBLIC_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION
# -----------------------------------------------------------------------------
# Image and media management service credentials
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# PAYMENT PROCESSING
# -----------------------------------------------------------------------------
# Stripe payment gateway configuration
# Get your publishable key from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# -----------------------------------------------------------------------------
# SOCIAL AUTHENTICATION
# -----------------------------------------------------------------------------

# Google OAuth Configuration
# Get your client ID from: https://console.developers.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# LinkedIn OAuth Configuration
# Get your client ID from: https://www.linkedin.com/developers/apps
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
NEXT_PUBLIC_LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
